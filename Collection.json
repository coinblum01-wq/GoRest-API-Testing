              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\r",
                  "pm.test(\"Status là inactive\", () => {\r",
                  "    pm.expect(pm.response.json().status).to.eql(\"inactive\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
